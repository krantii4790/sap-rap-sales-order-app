projection;
strict ( 2 );
use draft;

define behavior for Y182C_RAP_HEADER //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action ApprovedStatus;
  use action copyCustomer;

  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for Y182C_RAP_ITEM //alias <alias_name>
{
  use update;
  use delete;

  use association _HEADER { with draft; }
}